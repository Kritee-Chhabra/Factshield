# Copy to .env (never commit .env) — all variables are optional.

# Server-side Sarvam AI key. When set, /analyze uses Sarvam AI for every request
# and falls back to the heuristic engine if the call fails.
SARVAM_API_KEY=

# Optional Sarvam overrides
# SARVAM_MODEL=sarvam-105b
# SARVAM_TIMEOUT=30

# Comma-separated allowed CORS origins (default: *)
# CORS_ORIGINS=https://your-user.github.io

# Maximum accepted /analyze input length in characters (default: 10000)
# MAX_TEXT_LENGTH=10000
